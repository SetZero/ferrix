# The hosts file the name-resolution tests read. Every address is from a
# range reserved for documentation: RFC 5737's 192.0.2.0/24 and 198.51.100.0/24,
# and RFC 3849's 2001:db8::/32.

192.0.2.10	server.example.test alias

# One name with two IPv4 addresses and one IPv6 address.
192.0.2.20	multi.example.test
192.0.2.21	multi.example.test other.example.test
2001:db8::20	multi.example.test

# A name with no IPv4 address at all.
2001:db8::6	six.example.test

# A comment names no host.
#192.0.2.99	commented
