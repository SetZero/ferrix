+/* Ferrix has no sysfs, which is where libdrm's drmGetDevices2 learns what a
+ * node is, so it finds no devices there. The render nodes are opened by name
+ * instead, and the first whose driver is virtio_gpu is taken, as a platform
+ * device: Venus asks nothing of the bus but that it is one it knows. */
+static VkResult
+virtgpu_open_by_name(struct virtgpu *gpu)
+{
+   for (int minor = 128; minor < 136; minor++) {
+      char render[32];
+      snprintf(render, sizeof(render), "/dev/dri/renderD%d", minor);
+      char *nodes[DRM_NODE_MAX] = { [DRM_NODE_RENDER] = render };
+      struct _drmDevice dev = {
+         .nodes = nodes,
+         .available_nodes = 1 << DRM_NODE_RENDER,
+         .bustype = DRM_BUS_PLATFORM,
+      };
+      if (virtgpu_open_device(gpu, &dev) == VK_SUCCESS)
+         return VK_SUCCESS;
+   }
+   return VK_ERROR_INITIALIZATION_FAILED;
+}
