# The answers `cargo xtask remote-desktop` asks for. Copy this to one of
#
#   ./remote-desktop.toml            (this checkout; git ignores it)
#   ~/.config/ferrix/remote.toml     (every checkout on this machine)
#
# or name one with --config, or with $FERRIX_REMOTE. One file is one machine;
# a second machine is a second file and a --config that names it. A machine
# tried once needs no file: `--host <ssh destination>` is enough.
#
# This is the full desktop flavour: release builds, 3D, clipboard, a large
# screen, two keyboard layouts, a wallpaper, four CPUs and 1 GiB of memory.
# Trim the list under [boot] to make a smaller profile. A key this reader does
# not know is an error rather than a line quietly ignored, because a setting
# that silently does not apply is the worst kind of bug in a tool whose whole
# job is "the same every time". It reads strings, whole numbers and lists of
# strings -- the file is answers, not a program.

[remote]
# An `ssh` destination. A name out of ~/.ssh/config is the point: the user,
# the key and a ProxyJump two hops away are already written there, and
# nothing about any machine belongs in this repository.
host = "the-name-in-your-ssh-config"

# The checkout over there, made the first time and reused after. Relative to
# the remote home unless it starts with `/`. It holds a `target/` directory
# too, which is why reusing one matters: the second boot builds almost
# nothing.
dir = "ferrix-desktop"

# `cargo`, if it is not on a non-interactive shell's PATH over there. The
# script already puts ~/.cargo/bin, ~/.local/bin and /usr/local/bin on it.
cargo = "cargo"

# Anything the remote boot should have in its environment. FERRIX_QEMU names
# a QEMU that is not the one on PATH -- a directory of binaries or one
# binary -- which is how a machine whose distribution QEMU has no
# virglrenderer still gets `--gl`.
[remote.env]
# FERRIX_QEMU = "/opt/qemu/bin" # Uncomment if this machine's QEMU lacks virgl.
# FERRIX_WALLPAPERS = "/home/you/.local/share/ferrix/wallpapers"

[boot]
# `run-compositor` for the desktop; `run` for a program of your own, with
# `--init <path>` among the args below.
command = "run-compositor"
arch = "x86_64"

# Everything else `cargo xtask` takes, as it is written on a command line.
# This remote command supplies `--vnc :0`; do not add another `--vnc` here.
# Replace the wallpaper name, or use "none" for a plain background.
args = [
    "--release",
    "--gl",
    "--clipboard",
    "--size", "1920x1080",
    "--layout", "de,us",
    "--variant", "nodeadkeys,",
    "--wallpaper", "<part-of-a-wallpaper-name>",
    "--smp", "4",
    "--memory", "1024",
]
# "--rendernode", "/dev/dri/renderD128" # Select the GPU for --gl when needed.
# "--config", "/path/hyprland.conf"     # A config that exists on the remote host.
# "--no-net"                             # The network is enabled unless this is added.

[screen]
# The VNC display over there: display n is port 5900 + n. Two people on one
# machine want two numbers; `--vnc :1` says one for a single run.
display = 0

# The port the tunnel listens on here. `auto` takes 5900 + display when it is
# free and the next one up when it is not, which matters on a machine that
# runs a VNC server of its own.
local_port = "auto"

# `auto` finds RealVNC, TigerVNC, UltraVNC, Remmina or macOS Screen Sharing.
# `none` opens the tunnel and nothing else. Otherwise a command line, best
# written as a list so a Windows path needs no escaping; `{address}`,
# `{host}` and `{port}` are filled in.
viewer = "auto"
# viewer = ["C:\\Program Files\\RealVNC\\VNC Viewer\\vncviewer.exe", "{address}"]

# How long to wait for the screen. The first boot on a machine builds the
# whole tree, which is most of this.
wait = 1800

[source]
# `working-tree` boots what you are looking at, uncommitted changes and all,
# without touching your index. `head` boots your last commit instead.
send = "working-tree"

[ssh]
# `run-compositor` starts sshdt in the guest, and the tunnel carries it here:
# `ssh -p <local port> root@127.0.0.1` once the desktop is up. The keys that
# may log in to the remote machine may log in to the guest. The port over
# there; 0 turns SSH off.
port = 22022

# The port here. `auto` takes the same number when it is free and the next
# one up when it is not.
local_port = "auto"
