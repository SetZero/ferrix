FRAG
DCL IN[0], GENERIC[0], PERSPECTIVE
DCL OUT[0], COLOR
DCL SAMP[0]
DCL SVIEW[0], 2D, FLOAT
DCL CONST[0]
DCL TEMP[0..14]
IMM[0] UINT32 {1065353216, 3212836864, 1056964608, 1073741824}
IMM[1] FLT32 {0x3f800000, 0x00000000, 0x00000000, 0x00000000}
DCL TEMP[15..18]
  0: MUL TEMP[2].xy, IN[0].zwxx, CONST[0].xyxx
  1: TEX TEMP[1], TEMP[2].xyxx, SAMP[0], 2D
  2: FSNE TEMP[3].x, CONST[0].zxxx, IMM[0].xxxx
  3: UIF TEMP[3].xxxx :20
  4:   MOV_SAT TEMP[4].xyz, TEMP[1].xyzx
  5:   MUL TEMP[5].xyz, TEMP[4].xyzx, IMM[0].yyyy
  6:   FSGE TEMP[6].xyz, TEMP[4].xyzx, IMM[0].zzzz
  7:   AND TEMP[7].xyz, TEMP[6].xyzx, IMM[1].xxxx
  8:   ADD TEMP[8].xyz, IMM[0].xxxx, TEMP[5].xyzx
  9:   LRP TEMP[9].xyz, TEMP[7].xyzx, TEMP[8].xyzx, TEMP[4].xyzx
 10:   MUL TEMP[10].xyz, IMM[0].wwww, TEMP[9].xyzx
 11:   POW TEMP[11].x, TEMP[10].xxxx, CONST[0].zzzz
 12:   POW TEMP[11].y, TEMP[10].yyyy, CONST[0].zzzz
 13:   POW TEMP[11].z, TEMP[10].zzzz, CONST[0].zzzz
 14:   MUL TEMP[12].xyz, IMM[0].zzzz, TEMP[11].xyzx
 15:   MUL TEMP[13].xyz, TEMP[12].xyzx, IMM[0].yyyy
 16:   ADD TEMP[14].xyz, IMM[0].xxxx, TEMP[13].xyzx
 17:   LRP TEMP[0].xyz, TEMP[7].xyzx, TEMP[14].xyzx, TEMP[12].xyzx
 18:   MOV TEMP[0].w, TEMP[1].xxxw
 19:   MOV TEMP[1], TEMP[0]
 20: ENDIF
 21: MUL OUT[0].xyz, TEMP[1].xyzx, CONST[0].wwww
 22: MOV OUT[0].w, TEMP[1].xxxw
 23: END
