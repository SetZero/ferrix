{
  "manifest_version": 3,
  "name": "Ferrix",
  "description": "Says that this browser runs on Ferrix, where Chrome's build says Linux, and gives pages Ferrix's sans-serif.",
  "version": "1.0",
  "permissions": ["declarativeNetRequest", "fontSettings"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "fonts.js" },
  "declarative_net_request": {
    "rule_resources": [{ "id": "platform", "enabled": true, "path": "rules.json" }]
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["platform.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true,
      "world": "MAIN"
    }
  ]
}
