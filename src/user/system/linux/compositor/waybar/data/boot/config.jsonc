// The waybar boot's config: the user's bar, module for module, with every
// script it runs replaced by one that prints a fixed answer, so the picture
// the guest shows can be drawn on the host too (`waybar --render`). The
// style is the user's own ~/.config/waybar/style.css, carried in at gate
// time and never committed; see xtask's `waybar` boot.
//
// cpu, memory and network are left out: their numbers are the machine's,
// and differ between the host that draws the expected picture and the
// guest. The tray is in, and is hidden on both, as waybar hides an empty one.
{
    "output": "Virtual-1",
    "layer": "top",
    "position": "top",
    "height": 40,
    "spacing": 6,
    "modules-left": ["custom/launcher", "hyprland/window"],
    "modules-center": ["custom/clock"],
    "modules-right": ["custom/ws-1", "custom/ws-2", "custom/ws-3", "custom/ws-4",
                      "pulseaudio", "tray", "custom/logout"],
    "custom/launcher": {
        "format": " ",
        "tooltip-format": "<span line_height='2.0'>  Applications  (SUPER+Space)  </span>"
    },
    "hyprland/window": {
        "format": "{title}",
        "separate-outputs": false,
        "max-length": 44
    },
    "custom/ws-1": { "exec": "echo '{\"text\": \"1\", \"class\": [\"ws\", \"active\"]}'", "return-type": "json", "interval": "once", "signal": 5 },
    "custom/ws-2": { "exec": "echo '{\"text\": \"2\", \"class\": [\"ws\", \"visible\"]}'", "return-type": "json", "interval": "once", "signal": 5 },
    "custom/ws-3": { "exec": "echo '{\"text\": \"3\", \"class\": [\"ws\", \"stashed\"]}'", "return-type": "json", "interval": "once", "signal": 5 },
    "custom/ws-4": { "exec": "echo '{\"text\": \"4\", \"class\": [\"ws\", \"urgent\"]}'", "return-type": "json", "interval": "once", "signal": 5 },
    "pulseaudio": {
        "format": "vol {volume}%",
        "format-muted": "muted",
        "tooltip-format": "<span line_height='2.0'>  {desc}  </span>"
    },
    "tray": { "icon-size": 18, "spacing": 8 },
    "custom/logout": {
        "format": " ",
        "tooltip-format": "<span line_height='2.0'>  End session  </span>"
    },
    "custom/clock": {
        "exec": "echo '{\"text\": \"Sun 27 Sep  12:00\"}'",
        "return-type": "json",
        "interval": "once"
    }
}
