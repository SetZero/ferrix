FRAG
DCL IN[0], GENERIC[0], PERSPECTIVE
DCL OUT[0], COLOR
DCL CONST[0..2]
DCL TEMP[0..18]
IMM[0] UINT32 {3212836864, 0, 0, 0}
IMM[1] FLT32 {0x3f800000, 0x00000000, 0x00000000, 0x00000000}
DCL TEMP[19..22]
  0: ADD TEMP[0].xy, CONST[1].xyxx, CONST[2].xxxx
  1: MUL TEMP[1].xy, IN[0].zwxx, IMM[0].xxxx
  2: ADD TEMP[2].xy, TEMP[0].xyxx, TEMP[1].xyxx
  3: ADD TEMP[3].xy, CONST[1].xyxx, CONST[1].zwxx
  4: MUL TEMP[4].x, CONST[2].xxxx, IMM[0].xxxx
  5: ADD TEMP[5].xy, TEMP[3].xyxx, TEMP[4].xxxx
  6: MUL TEMP[6].xy, TEMP[5].xyxx, IMM[0].xxxx
  7: ADD TEMP[7].xy, IN[0].zwxx, TEMP[6].xyxx
  8: MAX TEMP[8].xy, TEMP[2].xyxx, TEMP[7].xyxx
  9: MAX TEMP[9].xy, TEMP[8].xyxx, IMM[0].yyyy
 10: MIN_PRECISE TEMP[10].x, CONST[2].xxxx, TEMP[9].xxxx
 11: MIN_PRECISE TEMP[11].x, TEMP[10].xxxx, TEMP[8].yxxx
 12: POW TEMP[12].x, TEMP[9].xxxx, CONST[2].yyyy
 13: POW TEMP[12].y, TEMP[9].yyyy, CONST[2].yyyy
 14: POW TEMP[13].x, CONST[2].xxxx, CONST[2].yyyy
 15: ADD TEMP[14].x, TEMP[12].xxxx, TEMP[12].yxxx
 16: FSLT TEMP[15].x, TEMP[14].xxxx, TEMP[13].xxxx
 17: FSGE TEMP[16].x, IMM[0].yyyy, TEMP[11].xxxx
 18: OR TEMP[17].x, TEMP[16].xxxx, TEMP[15].xxxx
 19: AND TEMP[18].x, TEMP[17].xxxx, IMM[1].xxxx
 20: MUL OUT[0], CONST[0], TEMP[18].xxxx
 21: END
