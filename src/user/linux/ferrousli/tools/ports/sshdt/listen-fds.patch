+
+/// The listening socket a service manager passed this process, if any: fd 3,
+/// when `LISTEN_PID` is this process and `LISTEN_FDS` counts at least one, as
+/// `sd_listen_fds(3)` has it.
+#[cfg(unix)]
+fn listen_fd() -> Option<std::net::TcpListener> {
+    use std::os::fd::FromRawFd as _;
+    let pid: u32 = std::env::var("LISTEN_PID").ok()?.parse().ok()?;
+    let count: u32 = std::env::var("LISTEN_FDS").ok()?.parse().ok()?;
+    if pid != std::process::id() || count == 0 {
+        return None;
+    }
+    // SAFETY: fd 3 is the first socket the manager passed, as the two
+    // variables above say, and nothing else in this process owns it.
+    Some(unsafe { std::net::TcpListener::from_raw_fd(3) })
+}
+
+/// No socket activation off Unix.
+#[cfg(not(unix))]
+fn listen_fd() -> Option<std::net::TcpListener> {
+    None
+}
