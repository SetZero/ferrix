+
+    /// Serve on a socket already listening, as a service manager passes one
+    /// under socket activation (`sd_listen_fds(3)`), rather than binding.
+    pub async fn serve_on(self, listener: std::net::TcpListener) -> Result<ServerHandle> {
+        let bound = listener
+            .set_nonblocking(true)
+            .and_then(|()| TcpListener::from_std(listener));
+        let listener = bound.map_err(|source| Error::Bind {
+            addr: self.bind,
+            source,
+        })?;
+        self.serve_listener(listener).await
+    }
